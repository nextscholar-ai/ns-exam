# ============================================================
# EXAM ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# ---- App ----
APP_NAME=exam-engine
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_VERSION=0.1.0

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://exam_user:exam_pass@localhost:5432/exam_engine
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ---- Security / JWT (local auth: External + Guest students) ----
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- ERP Integration (ERP owns auth for ERP users) ----
ERP_API_BASE_URL=https://erp.example.com/api
ERP_API_KEY=change-me
ERP_TOKEN_VALIDATE_PATH=/auth/validate

# ---- Storage ----
STORAGE_BACKEND=local          # local | s3 (future)
STORAGE_BASE_PATH=./storage

# ---- Logging ----
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | console

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
