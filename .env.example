# ============================================================
# EXAM ENGINE - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in the values for production.
# Never commit .env to version control.

# ---- App ----
APP_NAME=exam-engine
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0

# ---- PostgreSQL Database ----
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/exam_engine
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ---- Security / JWT ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-256-bit-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- ERP Integration ----
# ERP base URL (must be accessible from Exam Engine)
ERP_API_BASE_URL=http://erp-server:8000
# API key for Exam Engine to access ERP integration endpoints
ERP_API_KEY=your-erp-api-key-here
# Path to ERP token validation endpoint
ERP_TOKEN_VALIDATE_PATH=/auth/validate-token
# Webhook timeout in seconds
ERP_WEBHOOK_TIMEOUT_SEC=10
# Webhook token for Exam Engine to POST to ERP webhook endpoints
ERP_WEBHOOK_TOKEN=your-erp-webhook-token-here

# ---- Storage ----
STORAGE_BACKEND=local
STORAGE_BASE_PATH=./storage

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ---- Email Notifications (Optional) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=notifications@your-domain.com
# SMTP_USE_TLS=true
# EMAIL_NOTIFICATIONS_ENABLED=false

# ---- Push Notifications (Optional) ----
# PUSH_NOTIFICATIONS_ENABLED=false
# PUSH_API_KEY=your-push-api-key
# PUSH_GATEWAY_URL=https://your-push-gateway.com
