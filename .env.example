# ============================================================
# EXAM ENGINE - LOCAL DEVELOPMENT
# ============================================================

# ---- App ----
APP_NAME=exam-engine
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# ---- PostgreSQL Database ----
# Replace YOUR_POSTGRES_PASSWORD with your PostgreSQL password
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/exam_engine
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ---- Security / JWT ----
# Generate a real secret; do not use the placeholder in production.
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- ERP Integration ----
# Your local ERP is expected to run on port 8000.
ERP_API_BASE_URL=http://127.0.0.1:8000
ERP_API_KEY=
ERP_TOKEN_VALIDATE_PATH=/auth/validate

# ---- Storage ----
STORAGE_BACKEND=local
STORAGE_BASE_PATH=./storage

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000